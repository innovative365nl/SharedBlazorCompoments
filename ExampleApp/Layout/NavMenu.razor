@using ExampleApp.Components
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid d-flex align-items-center justify-content-between">
        <a class="navbar-brand" href="">ExampleApp</a>
        <div class="d-flex align-items-center gap-2">
            <button title="Navigation menu" class="navbar-toggler me-2" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <TopUserMenu UserName="Daphne Zwuup"/>
        </div>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="text">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Text
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="changetracker">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Change Tracker
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="loading-circular">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> loading circular
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link" href="#" @onclick="ToggleGridMenu">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Grid
                <span class="ms-2">@((collapseGridMenu ? "▼" : "▲"))</span>
            </a>
            <div class="ps-3" style="display:@(collapseGridMenu ? "block" : "none")">
                <NavLink class="nav-link" href="grid">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Default Grid
                </NavLink>
                <NavLink class="nav-link" href="grid/complex/1">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Complex Grid 1
                </NavLink>
                <NavLink class="nav-link" href="grid/complex/2">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Complex Grid 2
                </NavLink>
                <NavLink class="nav-link" href="grid/complex/3">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Complex Grid 3
                </NavLink>
                <NavLink class="nav-link" href="grid/complex/4">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Complex Grid 4
                </NavLink>
                <NavLink class="nav-link" href="grid/complex/5">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Complex Grid 5
                </NavLink>
                <NavLink class="nav-link" href="grid/complex/6">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Complex Grid 6
                </NavLink>
                <NavLink class="nav-link" href="sample-grid-loading">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Sample Grid Loading
                </NavLink>
            </div>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="displayview">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Display View
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link" href="#" @onclick="ToggleSidepanelMenu">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Sidepanel
                <span class="ms-2">@((collapseSidepanelMenu ? "▼" : "▲"))</span>
            </a>
            <div class="ps-3" style="display:@(collapseSidepanelMenu ? "block" : "none")">
                <NavLink class="nav-link" href="dialog/1">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Side panel (simple)
                </NavLink>
                <NavLink class="nav-link" href="dialog/2">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Side panel (advanced)
                </NavLink>
                <NavLink class="nav-link" href="dialog/3">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Side panel (Columns)
                </NavLink>
                <NavLink class="nav-link" href="dialog/4">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Side panel (CustomComponent)
                </NavLink>
                <NavLink class="nav-link" href="dialog/5">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Side panel (Decimal)
                </NavLink>
                <NavLink class="nav-link" href="example-close-on-save-form">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> sidepanel close save
                </NavLink>
            </div>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="example-innovative-alert">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Innovative Alert
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="examplelocaltimezone">
                <span class="bi bi-clock-nav-menu" aria-hidden="true"></span> Example Time Zone
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool collapseGridMenu = false;
    private bool collapseSidepanelMenu = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
    private void ToggleGridMenu()
    {
        collapseGridMenu = !collapseGridMenu;
    }
    private void ToggleSidepanelMenu()
    {
        collapseSidepanelMenu = !collapseSidepanelMenu;
    }
}

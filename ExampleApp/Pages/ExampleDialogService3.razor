@page "/dialog/3"

<h3>Dialog Example 3</h3>
<RadzenStack Orientation="Orientation.Horizontal"   >
    <RadzenButton Text="Open Ungrouped Dialog" Click="@OpenUngroupedDialog" ButtonStyle="ButtonStyle.Primary" />
    <RadzenButton Text="Open Single Column Dialog" Click="@OpenOneColumnDialog" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" />
    <RadzenButton Text="Open Two Column Dialog" Click="@OpenDoubleColumDialog" ButtonStyle="ButtonStyle.Primary" />
    <RadzenButton Text="Open Multi Column Dialog" Click="@OpenMultiColumnDialog" ButtonStyle="ButtonStyle.Primary" />
    <RadzenButton Text="Open Multi Column Dialog Large" Click="@OpenMultiColumnDialogLarge" ButtonStyle="ButtonStyle.Primary" />
    <RadzenButton Text="Open Multi Column Dialog Extra Large" Click="@OpenMultiColumnDialogExtraLarge" ButtonStyle="ButtonStyle.Primary" />
</RadzenStack>

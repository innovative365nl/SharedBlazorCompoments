@page "/grid/complex/4"
@using System.Globalization
@using Innovative.Blazor.Components.Components

<h3> Grid Example 4</h3>
<p>Shows a grid with a preview control in the side panel.</p>
<p>The current language is: @CultureInfo.CurrentCulture.Name a.k.a @CultureInfo.CurrentCulture.DisplayName / @CultureInfo.CurrentCulture.EnglishName.</p>


<InnovativeGrid TItem="Person4GridModel"
                MinHeightOption="GridHeight.Max"
                Data="@items"
                EnableRowSelection="true"
                OnSelectionChanged="OnRowSelected" />

@namespace Innovative.Blazor.Components.Components
@using Innovative.Blazor.Components.Localizations
@typeparam TModel

<div class="sidepanel-content-wrapper" @onclick:stopPropagation data-test-id="@DataTestId">
    <div class="sidepanel-header">
        <div class="sidepanel-title">
            @if (ShowClose)
            {
            <button class="sidepanel-icon-button" id="sidePanelCloseButton"
                    @onclick="@sidePanelService.CloseSidepanel">
                <span class="material-symbols-outlined">tab_close_right</span>
            </button>
            }
            <h3>@Title</h3>
        </div>
        <div class="sidepanel-actions">
            @TitleBarContent
            @if (ShowEdit && !IsEditing && !isCustomDialog)
            {
                <RadzenButton class="sidepanel-icon-button" id="sidePanelEditButton"
                              Disabled="@isBusy"
                        Click="@(args => IsEditing = !IsEditing)">
                    <span class="material-symbols-outlined">edit</span>
                </RadzenButton>
            }
            else if ((ShowEdit && IsEditing) || isCustomDialog)
            {
                <RadzenButton class="sidepanel-icon-button"
                              Disabled="@isBusy"
                    Click="@HandleSaveClick">
                    <span class="material-symbols-outlined">save</span>
                </RadzenButton>
                @if (!IsNewModel)
                {
                    <button class="sidepanel-icon-button"
                            @onclick="@HandleCancelClick">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                }
            }
            @if (ShowDelete && !IsEditing && !isCustomDialog)
            {
                <RadzenButton class="sidepanel-icon-button" ButtonStyle="ButtonStyle.Danger"
                        Click="@HandleDeleteClick">
                    <span class="material-symbols-outlined">delete</span>
                </RadzenButton>
            }
        </div>
    </div>
    <div class="sidepanel-content">
        @if (modelError != null)
        {
            <div class="alert alert-danger">@modelError</div>
        }
        else if (isBusy)
        {
            <div class="innovative-detail-busy">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>@Translations.Saving</span>
            </div>
            @if (progressLog?.Any() == true)
            {
                <div class="innovative-detail-progress">
                    @foreach (var line in progressLog)
                    {
                        <div>@line</div>
                    }
                </div>
            }
        }
        else
        {
            <CascadingValue Value="this">
                @if (!IsEditing && !isCustomDialog)
                {
                    @ViewChildContent
                }
                else if (!isCustomDialog)
                {
                    @EditChildContent
                }
                else
                {
                    @ActionChildContent
                }
            </CascadingValue>
        }
    </div>
    <div class="sidepanel-footer">
        @BottomBarContent
    </div>
</div>

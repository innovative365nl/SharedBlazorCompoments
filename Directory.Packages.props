<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft Packages -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.14" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="2.1.6" />
    <PackageVersion Include="Microsoft.NET.ILLink.Tasks" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Sdk.WebAssembly.Pack" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- 3rd party Packages -->
    <PackageVersion Include="Radzen.Blazor" Version="13.1.0" />
    <!-- Testing Packages -->
    <!-- Pinned above bunit's transitive 1.2.0, which carries the mXSS advisory GHSA-pgww-w46g-26qg (fixed in 1.5.0). -->
    <PackageVersion Include="AngleSharp" Version="1.10.4" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
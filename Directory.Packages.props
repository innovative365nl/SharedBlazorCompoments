<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft Packages -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12"/>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12"/>
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.13" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.12"/>
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.12"/>
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.12"/>
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="1.22.2"/>
    <PackageVersion Include="Microsoft.NET.ILLink.Tasks" Version="10.0.12"/>
    <PackageVersion Include="Microsoft.NET.Sdk.WebAssembly.Pack" Version="10.0.12"/>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <!-- 3rd party Packages -->
    <PackageVersion Include="Radzen.Blazor" Version="8.3.8"/>
    <!-- Testing Packages -->
    <!-- Pinned above bunit's transitive 1.2.0, which carries the mXSS advisory GHSA-pgww-w46g-26qg (fixed in 1.5.0). -->
    <PackageVersion Include="AngleSharp" Version="1.8.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>